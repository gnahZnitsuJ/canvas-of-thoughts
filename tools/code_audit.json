{
  "schema_version": "1.0.0",
  "source_roots": [
    "launcher",
    "model",
    "scripts"
  ],
  "exclusions": [
    {
      "pattern": "tests/**",
      "reason": "Test code is coverage input, not production-complexity scope."
    },
    {
      "pattern": "tools/**",
      "reason": "Audit implementation is excluded from the application audit."
    },
    {
      "pattern": ".venv/**",
      "reason": "Third-party environment."
    },
    {
      "pattern": "**/__pycache__/**",
      "reason": "Generated bytecode."
    },
    {
      "pattern": "model/checkpoints/**",
      "reason": "Generated model artifacts."
    },
    {
      "pattern": "model/results/**",
      "reason": "Generated runtime results."
    }
  ],
  "git": {
    "max_commits": 500,
    "history_strategy": "first-parent",
    "change_coupling_min_commits": 2,
    "change_coupling_limit": 100
  },
  "coverage": {
    "branch": true,
    "test_command": [
      "-m",
      "unittest",
      "discover",
      "-s",
      "tests",
      "-v"
    ]
  }
}
